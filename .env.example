# GEMINI_API_KEY: Unused by this app (left commented out).
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ==============================================================================
# REAL GOOGLE GMAIL OTP DELIVERY (RECOMMENDED — WORKS FOR ALL 6 FAMILY PHONES)
# ==============================================================================
# Configure these in the AI Studio Secrets panel (never commit real passwords):
# 1. Turn ON 2-Step Verification in your Google Account (myaccount.google.com/security).
# 2. Create a 16-character Google App Password at https://myaccount.google.com/apppasswords
# 3. Add GMAIL_SMTP_EMAIL and GMAIL_SMTP_APP_PASSWORD in AI Studio Secrets.
GMAIL_SMTP_EMAIL=MY_GMAIL_ADDRESS
GMAIL_SMTP_APP_PASSWORD=MY_GMAIL_APP_PASSWORD

# OPTIONAL FALLBACK (Resend API — only needed if Gmail SMTP is not configured)
RESEND_API_KEY=MY_RESEND_API_KEY
OTP_FROM_EMAIL=onboarding@resend.dev
